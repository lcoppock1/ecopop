{
  "name": "ecopop",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8090",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:assets": "node scripts/system-check.mjs",
    "verify": "npx expo export --platform web --output-dir _verify_export"
  },
  "dependencies": {
    "expo-asset": "~12.0.12",
    "@expo-google-fonts/bubblegum-sans": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.6.16",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.32",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "vitest": "^3.2.4"
  },
  "private": true
}
